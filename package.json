{
  "name": "pi-squared",
  "version": "0.0.1",
  "description": "Pi extensions and skills",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill"
  ],
  "author": "dctrwatson",
  "license": "Unlicense",
  "bin": {
    "piw": "./bin/piw"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:dctrwatson/pi-squared.git"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "check": "node ./node_modules/typescript/bin/tsc --noEmit",
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "test": "node --experimental-strip-types --test tests/extensions/*.test.mjs tests/skills/*.test.mjs",
    "test:extensions": "node --experimental-strip-types --test tests/extensions/*.test.mjs",
    "test:skills": "node --test tests/skills/*.test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "typebox": "^1.1.32",
    "typescript": "^5.7.2"
  }
}
