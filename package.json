{
  "name": "pi-squared",
  "version": "0.0.1",
  "description": "Pi extensions and skills",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill"
  ],
  "author": "dctrwatson",
  "license": "Unlicense",
  "bin": {
    "piw": "./bin/piw"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:dctrwatson/pi-squared.git"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "check": "node ./node_modules/typescript/bin/tsc --noEmit",
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "audit:prod": "node ./scripts/audit-prod.mjs",
    "test": "env -u CURSOR_API_KEY node --experimental-strip-types --test --test-concurrency=$(node -p \"Math.min(8, require('node:os').availableParallelism())\") tests/extensions/*.test.mjs tests/skills/*.test.mjs",
    "test:quick": "env -u CURSOR_API_KEY node --experimental-strip-types --test $(find tests/extensions -name '*.test.mjs' ! -name 'workspace-*')",
    "test:extensions": "env -u CURSOR_API_KEY node --experimental-strip-types --test tests/extensions/*.test.mjs",
    "test:skills": "env -u CURSOR_API_KEY node --test tests/skills/*.test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=1.2.0",
    "@earendil-works/pi-ai": ">=1.2.0",
    "@earendil-works/pi-coding-agent": ">=1.2.0",
    "@earendil-works/pi-tui": ">=1.2.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^1.2.0",
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@earendil-works/pi-tui": "^1.2.0",
    "@types/node": "^25.2.1",
    "typebox": "^1.1.32",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.28"
  }
}
